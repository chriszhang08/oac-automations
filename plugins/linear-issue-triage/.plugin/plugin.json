{
  "name": "linear-issue-triage",
  "version": "0.1.0",
  "description": "Automatically classify new EkkoLLM issues and link clear duplicates or related issues.",
  "automation": {
    "schema_version": "openhands.automation.plugin.v1",
    "entrypoint": {
      "runner": "conversation",
      "command": "triage"
    },
    "runtime": {
      "agent_profile": {
        "required": true,
        "default_name": "default",
        "allowed_mcp_server_refs": ["linear"]
      }
    },
    "suggested_trigger": {
      "type": "cron",
      "schedule": "*/5 * * * *",
      "timezone": "UTC"
    }
  }
}
