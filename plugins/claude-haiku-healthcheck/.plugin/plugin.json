{
  "name": "claude-haiku-healthcheck",
  "version": "0.2.0",
  "description": "Every 6 hours (03:00, 09:00, 15:00, 21:00 UTC): finds open [openspec-audit] PRs in the planning store, and if their CI has an `openspec validate` failure, starts a claude-haiku conversation that fixes and pushes it. No failure means a successful no-op. Tags the conversation temporary=true for the sweeper.",
  "automation": {
    "schema_version": "openhands.automation.plugin.v1",
    "entrypoint": {
      "runner": "script",
      "command": "python3 scripts/main.py"
    },
    "runtime": {
      "agent_profile": {
        "required": true,
        "default_name": "claude-haiku"
      }
    },
    "suggested_trigger": {
      "type": "cron",
      "schedule": "0 3,9,15,21 * * *",
      "timezone": "UTC"
    },
    "config_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "store_repo": {
          "type": "string",
          "default": "chriszhang08/odysseus-planner",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "title_prefix": {
          "type": "string",
          "default": "[openspec-audit]"
        },
        "validate_marker": {
          "type": "string",
          "default": "openspec validate",
          "description": "Substring of the failing CI step name that counts as a validate failure."
        },
        "github_secret": {
          "type": "string",
          "default": "GITHUB_TOKEN"
        }
      }
    }
  }
}
